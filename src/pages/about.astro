---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME, AUTHOR_EMAIL } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About Me" description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 py-12">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <!-- Hero -->
        <header class="text-center mb-16 animate-fade-in">
          <div class="mx-auto mb-8">
            <div class="w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white text-4xl font-bold">
              PK
            </div>
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">
            About {AUTHOR_NAME}
          </h1>
          <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto leading-relaxed">
            Software Development Engineer & Cloud Solution Architect. Building scalable systems and sharing knowledge.
          </p>
        </header>

        <!-- Bio -->
        <section class="mb-16 animate-slide-up">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6 pb-2 border-b border-[var(--color-border)]">Bio</h2>
          <div class="prose max-w-none">
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-4">
              <strong>{AUTHOR_NAME}</strong> is a <strong>Software Development Engineer</strong> & <strong>Cloud Solution Architect</strong> enthusiast. 
              He pursued his Master's degree in <strong>Computer Science</strong> from <strong>Goa University</strong>.
            </p>
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-4">
              He likes to solve bigger problems by breaking them into smaller chunks, 
              with that he tries to help organisations grow and meet their goals in time.
            </p>
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-4">
              Also, helping to onboard smaller businesses to showcase on the worldwide web, 
              with minimal expense.
            </p>
          </div>
        </section>

        <!-- Career Highlights -->
        <section class="mb-16 animate-slide-up">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6 pb-2 border-b border-[var(--color-border)]">Career Highlights</h2>
          <div class="space-y-4">
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">E-commerce & Startups</h3>
              <ul class="space-y-2 text-[var(--color-text-muted)]">
                <li>• On-boarded 2 start-ups on an e-commerce platform at a minimal cost</li>
              </ul>
            </div>
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Architecture Transformation</h3>
              <ul class="space-y-2 text-[var(--color-text-muted)]">
                <li>• Helped an organisation to redesign an existing legacy system to a scalable Three-Tier Architecture</li>
                <li>• Helped an organisation to rebuild its huge real-time system from a monolith to a scalable microservice architecture</li>
              </ul>
            </div>
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Real-time Systems</h3>
              <ul class="space-y-2 text-[var(--color-text-muted)]">
                <li>• Helped an organisation to build a project and an algorithm for an online real-time delivery app</li>
                <li>• Helped an organisation to create a platform for dynamic forms to collect geo-spatial data with multi-database integrations</li>
                <li>• Created a frontend module to render satellite raster images in the browser with geospatial information</li>
              </ul>
            </div>
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Security & Resilience</h3>
              <ul class="space-y-2 text-[var(--color-text-muted)]">
                <li>• Re-designed an app to overcome an automated DDoS Botnet attack</li>
                <li>• Added security updates to the backend and E2EE on both client and backend</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Personal Interests -->
        <section class="mb-16 animate-slide-up">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6 pb-2 border-b border-[var(--color-border)]">Beyond Code</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <h3 class="text-lg font-semibold text-[var(--color-text)]">Travel & Adventure</h3>
              </div>
              <p class="text-[var(--color-text-muted)]">Loves to travel. PADI Certified – Open Water Diver. Explored places like the Great Rann of Kutch, Mount Abu, and more.</p>
            </div>
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <h3 class="text-lg font-semibold text-[var(--color-text)]">Fitness & Coaching</h3>
              </div>
              <p class="text-[var(--color-text-muted)]">Fitness enthusiast and Certified Fitness Coach. Believes in maintaining optimal daily performance at work and life.</p>
            </div>
          </div>
        </section>

        <!-- Contact -->
        <section class="animate-slide-up">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6 pb-2 border-b border-[var(--color-border)]">Get in Touch</h2>
          <div class="card p-6 sm:p-8">
            <p class="text-[var(--color-text-muted)] mb-6 max-w-xl">
              I'm always open to discussing interesting projects, collaboration opportunities, or just having a chat about technology.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href={`mailto:${AUTHOR_EMAIL}`} class="btn-primary">Email Me</a>
              <a href={`https://github.com/prajyotpro`} target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub</a>
              <a href={`https://linkedin.com/in/prajyotpro`} target="_blank" rel="noopener noreferrer" class="btn-secondary">LinkedIn</a>
              <a href={`https://twitter.com/prajyotpro`} target="_blank" rel="noopener noreferrer" class="btn-secondary">Twitter</a>
            </div>
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>